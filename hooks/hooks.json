{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/recall_pointer.py\" --root \"${CLAUDE_PROJECT_DIR}/.goodfellow\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard_engine.py\" --project-dir \"${CLAUDE_PROJECT_DIR}\""
          }
        ]
      }
    ]
  }
}
